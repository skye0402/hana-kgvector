# Copy this file to .env.local and fill in real values.

# SAP HANA Cloud
HANA_HOST=
# Optional if HANA_HOST already includes ":port" (e.g., "myhost.hana.prod:443")
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=

# LiteLLM Proxy (OpenAI-compatible)
LITELLM_PROXY_URL=https://litellm-apac.a549aaa.kyma.ondemand.com/
LITELLM_API_KEY=

# Defaults
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
